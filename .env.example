# --- OpenAI ---
# Two different keys are involved:
#  - Answer generation (chat) uses each tenant's OWN key, read from Tenant.openaiApiKey via DATABASE_URL.
#  - OPENAI_API_KEY below is the server's key and IS required: it is used for embeddings
#    (searching the knowledge base on every question, and scripts/ingest.py). If it is empty or
#    invalid, every question fails for every company, whatever their own key.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Shared with backend_botivate_os (must match exactly) ---
JWT_SECRET=your-secret-key

# --- Node backend connectivity ---
NODE_BACKEND_URL=http://localhost:5000/api

# --- Shared Postgres — same DB backend_botivate_os and agent-botivateOS use ---
# Required for per-tenant OpenAI key lookup (Tenant.openaiApiKey).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Vector store ---
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma

# --- Knowledge base ---
KNOWLEDGE_BASE_DIR=./knowledge_base
DEPARTMENT_MODULE_MAP_PATH=./config/department_module_map.yaml

# --- App ---
# development enables the demo login and the test page. On every server leave it as production (the default).
APP_ENV=development
LOG_LEVEL=INFO
